{
    "name": "waterloobae/crowdmarkapilaravel",
    "description": "A dashboard for crowdmark",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "setasign/fpdf": "^1.8",
        "setasign/fpdi": "^2.3"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0 || ^10.0 || ^11.0",
        "pestphp/pest": "^3.0 || ^4.0"
    },
    "autoload": {
        "psr-4": {
            "Waterloobae\\CrowdmarkApiLaravel\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Waterloobae\\CrowdmarkApiLaravel\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
